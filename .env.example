# =====================================================================
#  E-ZONE Catalog Studio — environment variables
#  Copy this file to .env.local and fill in the values.
#  .env.local is git-ignored. NEVER commit real keys.
#  Only variables prefixed with NEXT_PUBLIC_ are sent to the browser —
#  never put a secret in a NEXT_PUBLIC_ variable.
# =====================================================================

# --- Login & sessions (required) -------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-random-password
ADMIN_NAME=مدير النظام
# Random string, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- API protection --------------------------------------------------
# Extra origins allowed to call the API (comma separated). Same-origin is always allowed.
ALLOWED_ORIGINS=
# Server log level: debug | info | warn | error | silent (secrets are always redacted)
LOG_LEVEL=info

# --- Appwrite (optional) ---------------------------------------------
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=catalog_studio
APPWRITE_BUCKET_ID=catalog_files

# --- Google Gemini AI (server-side only) -----------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Chrome binary for PDF rendering ---------------------------------
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# --- Odoo ERP (server-side only) -------------------------------------
ODOO_URL=https://your-company.odoo.com
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=
ODOO_SALE_PRICE_FIELD=lst_price
ODOO_CUSTOMER_PRICE_FIELD=customer_sale_price

# --- Shopify (server-side only) --------------------------------------
SHOPIFY_STORE_DOMAIN=https://your-store.com
SHOPIFY_MYSHOPIFY_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-04
